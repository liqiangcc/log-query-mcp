{
  "version": 2,
  "connections": [
    {
      "connection_id": "bad-server",
      "type": "ssh",
      "host": "10.0.0.10",
      "username": "log-reader",
      "auth": {
        "type": "password",
        "password": "plaintext-is-forbidden"
      },
      "host_key": {
        "known_hosts_file": "/etc/log-query-mcp/known_hosts"
      }
    }
  ],
  "sources": [
    {
      "source_id": "remote-bad",
      "name": "Bad remote",
      "service": "bad-service",
      "environment": "test",
      "backend": { "type": "ssh", "connection_id": "bad-server" },
      "root": "/var/log/bad",
      "files": ["application.log"],
      "sync": {
        "freshness": "on_query",
        "bootstrap": { "type": "tail", "bytes": 1048576 }
      }
    }
  ],
  "cache": {
    "root": "/var/cache/log-query-mcp",
    "max_bytes": 1073741824,
    "max_bytes_per_source": 536870912,
    "retention_hours": 24,
    "max_generations_per_file": 2
  }
}
