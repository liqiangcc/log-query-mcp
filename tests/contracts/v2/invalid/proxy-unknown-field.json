{
  "version": 2,
  "connections": [
    {
      "connection_id": "proxied-test-server",
      "type": "ssh",
      "host": "10.20.30.40",
      "username": "log-reader",
      "auth": {
        "type": "password",
        "secret_ref": "PROXIED_TEST_SERVER_PASSWORD"
      },
      "host_key": {
        "known_hosts_file": "/etc/log-query-mcp/known_hosts"
      },
      "proxy": {
        "type": "command",
        "program": "proxy-helper",
        "args": ["{host}", "{port}"],
        "command": "forbidden shell string"
      }
    }
  ],
  "sources": [
    {
      "source_id": "proxied-order-test",
      "name": "Proxied order test logs",
      "service": "order-service",
      "environment": "test",
      "backend": {
        "type": "ssh",
        "connection_id": "proxied-test-server"
      },
      "root": "/data/log/order-service",
      "files": ["application.log"],
      "sync": {
        "freshness": "on_query",
        "bootstrap": { "type": "full" },
        "allow_stale_on_error": false
      }
    }
  ],
  "cache": {
    "root": "/var/cache/log-query-mcp",
    "max_bytes": 21474836480,
    "max_bytes_per_source": 5368709120,
    "retention_hours": 168,
    "max_generations_per_file": 4
  }
}
