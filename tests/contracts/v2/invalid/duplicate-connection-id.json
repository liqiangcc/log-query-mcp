{
  "version": 2,
  "connections": [
    {
      "connection_id": "dup-server",
      "type": "ssh",
      "host": "10.0.0.10",
      "username": "log-reader",
      "auth": { "type": "password", "secret_ref": "PASSWORD_A" },
      "host_key": { "known_hosts_file": "/etc/log-query-mcp/known_hosts" }
    },
    {
      "connection_id": "dup-server",
      "type": "ssh",
      "host": "10.0.0.11",
      "username": "log-reader",
      "auth": { "type": "password", "secret_ref": "PASSWORD_B" },
      "host_key": { "known_hosts_file": "/etc/log-query-mcp/known_hosts" }
    }
  ],
  "sources": [
    {
      "source_id": "remote-test",
      "name": "Remote test",
      "service": "service-a",
      "environment": "test",
      "backend": { "type": "ssh", "connection_id": "dup-server" },
      "root": "/var/log/service-a",
      "files": ["application.log"],
      "sync": {
        "freshness": "on_query",
        "bootstrap": { "type": "full" }
      }
    }
  ],
  "cache": {
    "root": "/var/cache/log-query-mcp",
    "max_bytes": 1073741824,
    "max_bytes_per_source": 536870912,
    "retention_hours": 24,
    "max_generations_per_file": 2
  }
}
