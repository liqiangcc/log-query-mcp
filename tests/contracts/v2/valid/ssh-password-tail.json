{
  "version": 2,
  "connections": [
    {
      "connection_id": "test-server-01",
      "type": "ssh",
      "host": "10.0.0.10",
      "port": 22,
      "username": "log-reader",
      "auth": {
        "type": "password",
        "secret_ref": "TEST_SERVER_01_PASSWORD"
      },
      "host_key": {
        "known_hosts_file": "/etc/log-query-mcp/known_hosts"
      }
    }
  ],
  "sources": [
    {
      "source_id": "remote-order-test",
      "name": "Remote order test logs",
      "service": "order-service",
      "environment": "test",
      "backend": {
        "type": "ssh",
        "connection_id": "test-server-01"
      },
      "root": "/data/log/order-service",
      "files": ["application.log", "application.log.1"],
      "sync": {
        "freshness": "on_query",
        "bootstrap": {
          "type": "tail",
          "bytes": 104857600
        },
        "allow_stale_on_error": false
      }
    }
  ],
  "cache": {
    "root": "/var/cache/log-query-mcp",
    "max_bytes": 21474836480,
    "max_bytes_per_source": 5368709120,
    "retention_hours": 168,
    "max_generations_per_file": 4
  }
}
