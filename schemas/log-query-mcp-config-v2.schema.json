{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://log-query-mcp.local/schemas/log-query-mcp-config-v2.schema.json",
  "title": "Log Query MCP service configuration v2",
  "description": "Draft v2 configuration for local and SSH/SFTP remote log sources with bounded local cache.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": { "const": 2 },
    "connections": {
      "type": "array",
      "maxItems": 100,
      "default": [],
      "items": { "$ref": "#/$defs/SshConnectionConfig" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/LogSourceConfig" }
    },
    "cache": { "$ref": "#/$defs/CacheConfig" },
    "limits": { "$ref": "#/$defs/LimitsConfig" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sources": {
            "contains": {
              "type": "object",
              "properties": {
                "backend": {
                  "type": "object",
                  "properties": { "type": { "const": "ssh" } },
                  "required": ["type"]
                }
              },
              "required": ["backend"]
            }
          }
        },
        "required": ["sources"]
      },
      "then": { "required": ["connections", "cache"] }
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "DirectoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+)$"
    },
    "DirectoryRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "include_suffixes"],
      "properties": {
        "path": { "$ref": "#/$defs/DirectoryPath" },
        "recursive": { "type": "boolean", "default": false },
        "include_suffixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\.[^/\\r\\n]+$"
          }
        }
      }
    },
    "Rfc3339TimestampRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prefix_bytes"],
      "properties": {
        "type": { "const": "rfc3339" },
        "prefix_bytes": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "CustomTimestampRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prefix_bytes", "format"],
      "properties": {
        "type": { "const": "custom" },
        "prefix_bytes": { "type": "integer", "minimum": 1, "maximum": 256 },
        "format": { "type": "string", "minLength": 1, "maxLength": 128 },
        "default_offset_seconds": {
          "type": ["integer", "null"],
          "minimum": -86399,
          "maximum": 86399,
          "default": null
        }
      }
    },
    "TimestampRule": {
      "oneOf": [
        { "$ref": "#/$defs/Rfc3339TimestampRule" },
        { "$ref": "#/$defs/CustomTimestampRule" }
      ]
    },
    "PasswordAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "secret_ref"],
      "properties": {
        "type": { "const": "password" },
        "secret_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        }
      }
    },
    "PrivateKeyAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key_file"],
      "properties": {
        "type": { "const": "private_key" },
        "key_file": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "passphrase_secret_ref": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
          "default": null
        }
      }
    },
    "SshAuth": {
      "oneOf": [
        { "$ref": "#/$defs/PasswordAuth" },
        { "$ref": "#/$defs/PrivateKeyAuth" }
      ]
    },
    "HostKeyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_hosts_file"],
      "properties": {
        "known_hosts_file": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "SshConnectionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_id", "type", "host", "username", "auth", "host_key"],
      "properties": {
        "connection_id": { "$ref": "#/$defs/Identifier" },
        "type": { "const": "ssh" },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\s/]+$"
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 22 },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\x00-\\x1f]+$"
        },
        "auth": { "$ref": "#/$defs/SshAuth" },
        "host_key": { "$ref": "#/$defs/HostKeyConfig" },
        "connect_timeout_millis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000,
          "default": 5000
        },
        "operation_timeout_millis": {
          "type": "integer",
          "minimum": 100,
          "maximum": 600000,
          "default": 30000
        },
        "keepalive_seconds": {
          "type": ["integer", "null"],
          "minimum": 5,
          "maximum": 3600,
          "default": 30
        }
      }
    },
    "LocalBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "local" } }
    },
    "SshBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "connection_id"],
      "properties": {
        "type": { "const": "ssh" },
        "connection_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "Backend": {
      "oneOf": [
        { "$ref": "#/$defs/LocalBackend" },
        { "$ref": "#/$defs/SshBackend" }
      ]
    },
    "BootstrapFull": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "full" } }
    },
    "BootstrapTail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bytes"],
      "properties": {
        "type": { "const": "tail" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 68719476736 }
      }
    },
    "BootstrapFromNow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "from_now" } }
    },
    "BootstrapPolicy": {
      "oneOf": [
        { "$ref": "#/$defs/BootstrapFull" },
        { "$ref": "#/$defs/BootstrapTail" },
        { "$ref": "#/$defs/BootstrapFromNow" }
      ]
    },
    "RemoteSyncPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freshness", "bootstrap"],
      "properties": {
        "freshness": { "const": "on_query" },
        "bootstrap": { "$ref": "#/$defs/BootstrapPolicy" },
        "allow_stale_on_error": { "const": false, "default": false }
      }
    },
    "LogSourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "service", "environment", "backend", "root"],
      "properties": {
        "source_id": { "$ref": "#/$defs/Identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "maxLength": 1024, "default": "" },
        "service": { "type": "string", "minLength": 1, "maxLength": 256 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "default": [],
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "enabled": { "type": "boolean", "default": true },
        "encoding": { "const": "utf-8", "default": "utf-8" },
        "backend": { "$ref": "#/$defs/Backend" },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "files": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "default": [],
          "items": { "$ref": "#/$defs/RelativePath" }
        },
        "directories": {
          "type": "array",
          "maxItems": 64,
          "default": [],
          "items": { "$ref": "#/$defs/DirectoryRule" }
        },
        "timestamp_rule": {
          "oneOf": [
            { "$ref": "#/$defs/TimestampRule" },
            { "type": "null" }
          ],
          "default": null
        },
        "sync": { "$ref": "#/$defs/RemoteSyncPolicy" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "type": "object",
                "properties": { "type": { "const": "ssh" } },
                "required": ["type"]
              }
            },
            "required": ["backend"]
          },
          "then": { "required": ["sync"] },
          "else": { "properties": { "sync": false } }
        }
      ],
      "anyOf": [
        {
          "required": ["files"],
          "properties": { "files": { "minItems": 1 } }
        },
        {
          "required": ["directories"],
          "properties": { "directories": { "minItems": 1 } }
        }
      ]
    },
    "CacheConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "max_bytes", "max_bytes_per_source", "retention_hours", "max_generations_per_file"],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1099511627776
        },
        "max_bytes_per_source": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 274877906944
        },
        "retention_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "max_generations_per_file": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        }
      }
    },
    "LimitsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_sources_per_query": { "type": "integer", "minimum": 1, "maximum": 10, "default": 10 },
        "max_scan_files_per_query": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 500 },
        "max_scan_bytes_per_page": { "type": "integer", "minimum": 1, "maximum": 68719476736, "default": 536870912 },
        "query_timeout_millis": { "type": "integer", "minimum": 1, "maximum": 600000, "default": 10000 },
        "default_results_per_page": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
        "max_results_per_page": { "type": "integer", "minimum": 1, "maximum": 200, "default": 200 },
        "max_line_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 16384 },
        "max_returned_content_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216, "default": 524288 },
        "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 33554432, "default": 1048576 },
        "max_context_lines_per_side": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 50 },
        "max_concurrent_scans": { "type": "integer", "minimum": 1, "maximum": 64, "default": 4 },
        "match_reference_capacity": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 10000 },
        "match_reference_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 600 },
        "cursor_capacity": { "type": "integer", "minimum": 1, "maximum": 100000, "default": 1000 },
        "cursor_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 300 },
        "max_concurrent_ssh_connections": { "type": "integer", "minimum": 1, "maximum": 64, "default": 4 },
        "max_sync_bytes_per_query": { "type": "integer", "minimum": 1, "maximum": 68719476736, "default": 536870912 },
        "max_remote_files_per_source": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 500 }
      }
    }
  }
}
