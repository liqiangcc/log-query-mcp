{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://log-query-mcp.local/schemas/log-query-mcp-config-v1.schema.json",
  "title": "Log Query MCP service configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/LogSourceConfig"
      }
    },
    "limits": {
      "$ref": "#/$defs/LimitsConfig"
    }
  },
  "$defs": {
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+$"
    },
    "DirectoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$)).+)$"
    },
    "DirectoryRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "include_suffixes"],
      "properties": {
        "path": {
          "$ref": "#/$defs/DirectoryPath"
        },
        "recursive": {
          "type": "boolean",
          "default": false
        },
        "include_suffixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\.[^/\\r\\n]+$"
          }
        }
      }
    },
    "Rfc3339TimestampRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prefix_bytes"],
      "properties": {
        "type": {
          "const": "rfc3339"
        },
        "prefix_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "CustomTimestampRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "prefix_bytes", "format"],
      "properties": {
        "type": {
          "const": "custom"
        },
        "prefix_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "default_offset_seconds": {
          "type": ["integer", "null"],
          "minimum": -86399,
          "maximum": 86399,
          "default": null
        }
      }
    },
    "TimestampRule": {
      "oneOf": [
        {
          "$ref": "#/$defs/Rfc3339TimestampRule"
        },
        {
          "$ref": "#/$defs/CustomTimestampRule"
        }
      ]
    },
    "LogSourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "service",
        "environment",
        "root"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 1024,
          "default": ""
        },
        "service": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "encoding": {
          "const": "utf-8",
          "default": "utf-8"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/"
        },
        "files": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "default": [],
          "items": {
            "$ref": "#/$defs/RelativePath"
          }
        },
        "directories": {
          "type": "array",
          "maxItems": 64,
          "default": [],
          "items": {
            "$ref": "#/$defs/DirectoryRule"
          }
        },
        "timestamp_rule": {
          "oneOf": [
            {
              "$ref": "#/$defs/TimestampRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "anyOf": [
        {
          "required": ["files"],
          "properties": {
            "files": {
              "minItems": 1
            }
          }
        },
        {
          "required": ["directories"],
          "properties": {
            "directories": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "LimitsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_sources_per_query": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 10
        },
        "max_scan_files_per_query": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 500
        },
        "max_scan_bytes_per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736,
          "default": 536870912
        },
        "query_timeout_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 10000
        },
        "default_results_per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "max_results_per_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 200
        },
        "max_line_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576,
          "default": 16384
        },
        "max_returned_content_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216,
          "default": 524288
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 1048576
        },
        "max_context_lines_per_side": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 50
        },
        "max_concurrent_scans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 4
        },
        "match_reference_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 10000
        },
        "match_reference_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 600
        },
        "cursor_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1000
        },
        "cursor_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "default": 300
        }
      }
    }
  }
}
